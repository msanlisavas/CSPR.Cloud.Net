<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>8.0</LangVersion> <!-- Set C# language version -->
    <Nullable>enable</Nullable> <!-- Enable nullable reference types -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile> <!-- Enable XML documentation generation -->
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile> <!-- Specify the documentation file path -->
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- Suppress warnings for missing XML comments -->

    <!-- NuGet Package Information -->
    <PackageId>CSPR.Cloud.Net</PackageId>
    <Version>4.2.0</Version>
    <Authors>msanlisavas</Authors>
    <Description>A .NET client library for interacting with the CSPR Cloud API, providing access to Casper blockchain data for both Mainnet and Testnet environments.</Description>
    <PackageProjectUrl>https://github.com/msanlisavas/CSPR.Cloud.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msanlisavas/CSPR.Cloud.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Casper;Blockchain;CSPR;Cloud;API;Client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>v4.2.0 — NEW: CasperCloudX402Client, a client for the CSPR.cloud x402 Facilitator API (https://x402-facilitator.cspr.cloud): GetSupportedAsync, VerifyAsync and SettleAsync over the x402 v2 protocol with the Casper "exact" scheme (CEP-3009 transfer_with_authorization signed authorizations). Ships the full protocol object model under CSPR.Cloud.Net.Objects.X402 (PaymentRequired challenge, PaymentPayload with the Casper authorization/publicKey/signature payload, facilitator request/response types). Amounts are strings end-to-end; protocol JSON is camelCase; every method takes a trailing optional CancellationToken. Note the facilitator answers HTTP 200 even for a failed settlement — branch on X402SettleResponse.Success, never the status code. Purely additive: no changes to existing REST or streaming APIs. Earlier: v4.1.0 added CancellationToken to every REST method; v4.0.x made money values decimal and added opt-in per-row tolerance with SkippedItemCount.</PackageReleaseNotes>

  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Icon\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSPR.Cloud.Net.Tests" />
  </ItemGroup>

</Project>
